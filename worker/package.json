{
  "name": "decode-it-worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "build": "tsc --noEmit && wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "secret:gemini": "wrangler secret put GEMINI_API_KEY",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
